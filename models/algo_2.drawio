<mxfile host="app.diagrams.net" modified="2026-11-23T00:00:00.000Z"><diagram name="Расчёт стоимости и сроков" id="algo_2"><mxGraphModel dx="1800" dy="1900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2600" pageHeight="2700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s" parent="1" vertex="1" value="Начало" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;"><mxGeometry x="439" y="120" width="121" height="48" as="geometry"/></mxCell><mxCell id="inp" parent="1" vertex="1" value="Ввести заказ, сотрудников, оборудование,&#10;время, тарифы и формат видео" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;"><mxGeometry x="120" y="222" width="760" height="100" as="geometry"/></mxCell><mxCell id="valid" parent="1" vertex="1" value="Длительность &amp;gt; 0, тариф p ≥ 0,&#10;конец съёмки задан, формат допустим?" style="rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;"><mxGeometry x="154" y="376" width="691" height="100" as="geometry"/></mxCell><mxCell id="bad" parent="1" vertex="1" value="Ошибка входных данных" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;"><mxGeometry x="189" y="621" width="473" height="68" as="geometry"/></mxCell><mxCell id="norm" parent="1" vertex="1" value="Норматив: 4K→8, 6K→10,&#10;8K→12 мин на минуту видео" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=15;align=center;verticalAlign=middle;"><mx